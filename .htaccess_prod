DirectoryIndex disabled
Options -Indexes

RewriteEngine On

# Send X-Robots-Tag on staging domain to prevent search indexing
<IfModule mod_headers.c>
    SetEnvIfNoCase Host "^lab\.landloom\.ai$" IS_STAGING
    Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet" env=IS_STAGING
    SetEnvIfNoCase Host "^(www\.)?landloom\.ai" LEAKED_STAGING_PATH
    Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet" env=LEAKED_STAGING_PATH
</IfModule>

# Block access when this staging directory is requested via the main domain
# (e.g. https://www.landloom.ai/lab.landloom.ai/ or https://landloom.ai/lab.landloom.ai/)
# Return HTTP 410 Gone so search engines permanently drop the URL from their index.
RewriteCond %{HTTP_HOST} ^(www\.)?landloom\.ai(:[0-9]+)?$ [NC]
RewriteRule ^ - [G,L]

# Block Facebook meta-externalagent crawler spam before it reaches gunicorn
RewriteCond %{HTTP_USER_AGENT} meta-externalagent [NC]
RewriteRule ^.*$ - [F,L]

# Exclude .well-known / Let's Encrypt certificates from proxying
RewriteCond %{REQUEST_URI} ^/\.well-known [NC]
RewriteRule ^ - [L]

# Large POST bodies (e.g. /api/generate-map-images with full project data) were
# corrupted when forwarded with chunked transfer encoding: gunicorn misparsed the
# stream and answered 404, and Apache answered 502 for bigger payloads.
# Spool the body and send a Content-Length instead, and do not reuse connections.
SetEnv proxy-sendcl 1
SetEnv proxy-nokeepalive 1
SetEnv proxy-initial-not-pooled 1

# Proxy all other requests to the Gunicorn app (port replaced by deploy/start_server)
RewriteRule ^(.*)$ http://127.0.0.1:8000/$1 [P,L]
