# OpenRouter API Key (required for all AI text/image generation)
OPENROUTER_KEY=your-openrouter-api-key-here

# OpenRouter Management key (optional but recommended for per-company keys).
# Create it at openrouter.ai/settings/management-keys — it only manages other
# keys and can never make inference calls. When set, every company gets its
# own dashboard-visible key with a spend limit (auto-provisioned on creation,
# plus super-admin manual add/rotate). When missing, all traffic uses OPENROUTER_KEY.
OPENROUTER_MANAGEMENT_KEY=your-openrouter-management-key-here

# Default spend limit (USD) for auto-provisioned company keys.
# Zero means prepaid: the key is verified blocked until the super admin
# raises its limit (top-up). Set higher only to grant free starting credit.
TENANT_OPENROUTER_DEFAULT_LIMIT_USD=0
# Reset policy for company key limits. 'none' = lifetime cap tied to the
# wallet: every debit/top-up re-syncs the limit, and renewal is always a
# deliberate super-admin act (recharge approval or manual limit), never an
# automatic provider reset. daily/weekly/monthly re-enable auto-renewal —
# only pick those for a genuinely auto-billed subscription.
TENANT_OPENROUTER_DEFAULT_RESET=none

# Strict per-company spend: when 1, a company without an active key of its
# own is refused before any AI call instead of burning the shared key.
# Super-admin operations always use the global key. Requires
# OPENROUTER_MANAGEMENT_KEY to be set — without it no company key can exist
# and every call would be refused. Production/staging: 1.
REQUIRE_TENANT_OPENROUTER_KEY=0

# Google Maps API Key (required for map slides)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Google Maps API rate limiting (calls per window in seconds)
# Default: 60 calls per 10 minutes per tenant
MAPS_RATE_LIMIT=60
MAPS_RATE_WINDOW=600

# Google Maps spend metering overrides (JSON mapping SKU names to dollars).
# Code defaults already cover the highest tier each call can land in, so a
# fresh server never under-bills. Override only to match your Cloud Billing.
MAPS_SKU_PRICES={"distance_matrix": 0.010, "places_text": 0.035, "places_nearby": 0.040, "staticmap": 0.002, "roads": 0.010, "directions": 0.005, "geocode": 0.005, "streetview": 0.007}

# Billing ledger: markup applied to raw provider cost at checkout time.
# The provider-side key cap is (balance + holds + package) / multiplier, so
# the multiplier also decides how much raw spend a wallet dollar buys.
# Google free usage caps are intentionally NOT subtracted: the recorded cost
# is the billable figure and any free allowance stays a platform margin.
BILLING_MULTIPLIER=1.60

# Pre-flight wallet enforcement. 0 keeps current behaviour (metering only).
# Set to 1 to refuse expensive operations when the balance is insufficient.
# Production/staging: 1 — the provider cap is the hard backstop, this guard
# is what fails fast with a clear Arabic error instead of a provider 402.
BILLING_ENFORCE=0

# Conservative billed-USD estimates per flow for the pre-flight check.
BILLING_PREFLIGHT_ESTIMATES={"analyze_site": 1.0, "site_analysis": 0.5, "map_image": 0.5, "slide_plan": 0.5, "slide_single": 0.25, "market_competitors": 1.0, "market_summary": 1.0, "croquis": 0.5}

# Slide presentation generation model (defaults to openai/gpt-6-sol)
SLIDE_TEXT_MODEL=openai/gpt-6-sol

# Public URL of this copy — outgoing mail links (password setup etc.) point
# here, because gunicorn behind Apache only ever sees 127.0.0.1.
# staging: https://lab.landloom.ai   production: https://landloom.ai
APP_BASE_URL=https://example.com

# Deploy webhook secret shared with GitHub Actions. deploy-staging.yml POSTs
# to /api/deploy-webhook-staging?secret=... on every lab push; deploy.yml
# (manual) hits /api/deploy-webhook. Staging falls back to this secret when
# its own is unset.
DEPLOY_WEBHOOK_SECRET=replace-with-a-long-random-string
# DEPLOY_WEBHOOK_SECRET_STAGING=optional-different-secret-for-staging

# Gunicorn bind port (127.0.0.1; Apache proxies to it via .htaccess).
# Staging reads STAGING_PORT first, then APP_PORT, then 8001.
# APP_PORT=8000
# STAGING_PORT=8001

# Path overrides — defaults already point at /home/landloom/... and only need
# setting if the account layout ever differs.
# PROD_APP_DIR=/home/landloom/proposal-generator
# PROD_REPO_DIR=/home/landloom/workflow.git
# PROD_WEB_ROOT=/home/landloom/public_html
# STAGING_APP_DIR=/home/landloom/proposal-generator-staging
# STAGING_REPO_DIR=/home/landloom/workflow.git
# STAGING_WEB_ROOT=/home/landloom/lab.landloom.ai

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=LandLoom AI <mailer@example.com>
SMTP_TLS=true
SMTP_SSL=false
